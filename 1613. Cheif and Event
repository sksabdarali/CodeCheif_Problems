import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc=new Scanner(System.in);
		int t=sc.nextInt();
		while(t-->0){
		    long k=sc.nextLong();
		    k--;
		    if(k==0){
		        System.out.println(0);
		        continue;
		    }
		    StringBuilder res=new StringBuilder();
		    while(k>0){
		        long digit=k%5;
		        res.append(digit*2);
		        k/=5;
		    }
		    System.out.println(res.reverse());
		    
		}

	}
}
